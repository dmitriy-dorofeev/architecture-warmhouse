@startuml monolith-context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title System Context диаграмма — текущее решение «Тёплый дом» (As-Is)

Person(user, "Пользователь", "Владелец дома. Управляет отоплением и смотрит температуру через веб-интерфейс")
Person(installer, "Специалист по подключению", "Сотрудник компании. Выезжает в дом и подключает систему отопления к приложению")

System(monolith, "Smart Home — монолит", "Go + Gin. Управление отоплением и мониторинг температуры. Все запросы обрабатываются синхронно")
SystemDb(db, "PostgreSQL", "Единая база данных. Таблица sensors с данными о датчиках и их показаниях")
System_Ext(heating, "Система отопления в доме", "Датчик температуры и модуль управления отоплением. Только отвечает на запросы сервера, сам ничего не отправляет")

Rel(user, monolith, "Включает/выключает отопление, смотрит температуру", "HTTPS")
Rel(installer, heating, "Подключает и настраивает оборудование вручную")
Rel(installer, monolith, "Регистрирует новый дом и датчик в системе")
Rel(monolith, heating, "Опрашивает датчик, отправляет команды вкл/выкл", "HTTP, синхронно")
Rel(monolith, db, "Читает и пишет данные", "SQL")

@enduml
